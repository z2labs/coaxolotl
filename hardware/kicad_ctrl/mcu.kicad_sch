  (text "J1: 1=GND 2=C2D 3=C2CK 4=3V3. TP7/TP8: UART0 for the factory bootloader (C2D low at reset)."
    (at 86.36 73.66 0)
    (effects
      (font
        (face "Arial")
        (size 1.27 1.27)
        italic
        (color 0 0 194 1)
      )
      (justify left bottom)
    )
    (uuid "d355c978-153f-4d63-b888-7b5f46175484")
  )
  (text "QFN32: own BEACON pin (P1.7 = PCA CEX0 during a reply), C2D not shared, 10 spares driven low."
    (at 78.74 184.15 0)
    (effects
      (font
        (face "Arial")
        (size 1.27 1.27)
        italic
        (color 0 0 194 1)
      )
      (justify left bottom)
    )
    (uuid "d82f8bff-d2c3-4a65-a436-cff81c5b74aa")
  )
  (text "EP is the only GND pin: solder it, with vias. VDD: 1 uF + 100 nF at the pin (AN203)."
    (at 78.74 187.33 0)
    (effects
      (font
        (face "Arial")
        (size 1.27 1.27)
        italic
        (color 0 0 194 1)
      )
      (justify left bottom)
    )
    (uuid "ce56c81c-c029-457b-8c3f-e3db50fda1ce")
  )
  (text "SYSCLK = HFOSC0/8 = 3.0625 MHz, Snooze when idle (no clock, no spurs). ILNA RC: fc = 1.6 kHz"
    (at 78.74 190.5 0)
    (effects
      (font
        (face "Arial")
        (size 1.27 1.27)
        italic
        (color 0 0 194 1)
      )
      (justify left bottom)
    )
    (uuid "8a07a4ce-2c77-495c-b372-989e8104efb4")
  )
