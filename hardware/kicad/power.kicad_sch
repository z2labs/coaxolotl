  (text "A  VCOAX tap (ahead of all bulk capacitance)"
    (at 16.27 23 0)
    (effects
      (font
        (size 2 2)
        bold
      )
      (justify left bottom)
    )
    (uuid "a048bbad-46bf-4d18-9eaf-f81b2a157559")
  )
  (text "Only these loads sit on VCOAX, so the OOK falling edge is set by R1 + coax/RTL capacitance."
    (at 16.27 91.33 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "48ffe4ca-5ffa-4b5a-b549-7395fe7bd36f")
  )
  (text "R1 = 680R gives ~6 ms with 10 uF on the RTL side; lower to 470R if bring-up step 1 needs it."
    (at 16.27 93.53 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "007e2d8b-ef14-4e1d-9088-3065f374ca85")
  )
